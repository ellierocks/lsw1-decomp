# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf

# Upstream newlib/fdlibm/libgcc sources are kept byte-for-byte (docs/sn_runtime.md),
# trailing whitespace included, so git diff --check skips them.
src/sn/libc/**    -whitespace
src/sn/libm/**    -whitespace
src/sn/libgcc/**  -whitespace
src/sn/include/** -whitespace
