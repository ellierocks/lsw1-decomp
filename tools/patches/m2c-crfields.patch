+        def cr_field(arg: Argument) -> Optional[int]:
+            if isinstance(arg, Register) and re.fullmatch(r"cr[0-7]", arg.register_name):
+                return int(arg.register_name[2])
+            return None
+
+        def cr_bit(arg: Argument) -> Optional[Register]:
+            """`cr7eq`/`cr7un` symbols or a raw CR bit number 0-31."""
+            names = ("lt", "gt", "eq", "so")
+            if isinstance(arg, AsmLiteral) and 0 <= arg.value < 32:
+                return Register(f"cr{arg.value // 4}_{names[arg.value % 4]}")
+            name = (
+                arg.register_name
+                if isinstance(arg, Register)
+                else arg.symbol_name if isinstance(arg, AsmGlobalSymbol) else ""
+            )
+            mt = re.fullmatch(r"cr([0-7])(lt|gt|eq|un|so)", name)
+            if mt is None:
+                return None
+            return Register(f"cr{mt.group(1)}_{'so' if mt.group(2) == 'un' else mt.group(2)}")
+
+        def cr_bits(n: int) -> List[Location]:
+            return [Register(f"cr{n}_{b}") for b in ("lt", "gt", "eq", "so")]
+
+        def crsave(reg: Register, n: int, b: str) -> Register:
+            return Register(f"crsave_{reg.register_name}_cr{n}_{b}")
