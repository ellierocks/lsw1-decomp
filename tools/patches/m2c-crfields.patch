+class CmpeqzPattern1(IrPattern):
+    """`x == 0` as GCC 2.95 computes it through the carry flag: `subfic` sets CA when
+    x == 0, and `adde` adds that CA to (-x + x)."""
+
+    replacement = "cmpeqz.fictive $o, $i"
+    parts = [
+        "subfic $a, $i, 0",
+        "adde $o, $a, $i",
+    ]
+
+
+class CmpeqzPattern2(IrPattern):
+    replacement = "cmpeqz.fictive $o, $i"
+    parts = [
+        "subfic $a, $i, 0",
+        "adde $o, $i, $a",
+    ]
+
+
+class NegCmpeqzPattern(IrPattern):
+    """`-(x == 0)`: addic CA is `x != 0`, and `subfe d, a, a` is CA - 1."""
+
+    replacement = "negcmpeqz.fictive $o, $i"
+    parts = [
+        "addic $a, $i, -1",
+        "subfe $o, $a, $a",
+    ]
+
+
+class CmpgtuPattern(IrPattern):
+    """`x >u K`: `subfic` sets CA when K >=u x, `subfe d, a, a` is CA - 1, and neg flips it."""
+
+    replacement = "cmpgtu.fictive $o, $i, K"
+    parts = [
+        "subfic $a, $i, K",
+        "subfe $b, $a, $a",
+        "neg $o, $b",
+    ]
+
